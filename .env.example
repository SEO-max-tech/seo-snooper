# ── Required ─────────────────────────────────────────────────────────────
# Supabase project (free tier is fine). Settings → API.
# Use the SERVICE ROLE key, not the anon key — the pipeline writes tables.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=

# Anthropic API key — powers the product-scope judge.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ── Optional ─────────────────────────────────────────────────────────────
# Judge model. Haiku is cheap and plenty for a yes/no scope call.
JUDGE_MODEL=claude-haiku-4-5

# Ahrefs API v3 key. Leave empty to run with the built-in stub provider,
# which returns deterministic fake volume/KD so the pipeline works end to
# end without a paid plan. Reports built from stub data say so.
AHREFS_API_KEY=

# Notification webhooks. Set any combination — every one that is set gets
# the report. With none set, the report prints to stdout.
SLACK_WEBHOOK_URL=
GCHAT_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
